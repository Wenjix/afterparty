{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/afterparty/bin/afterparty",
              "report",
              "--remind"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/afterparty/bin/afterparty",
              "report",
              "--session-end"
            ],
            "timeout": 1
          }
        ]
      }
    ]
  }
}
