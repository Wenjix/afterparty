#!/usr/bin/env bash
args="$*"
printf '%s  ps %s\n' "$(date +%s)" "$args" >> "T=/private/tmp/claude-501/-Users-wenjiefu-orca-afterparty/3a908d23-43f4-4e92-92d0-43ac0c56137d/scratchpad/ap09Kj7M/multi/ps.log"
case "$args" in
  *"pid,ppid,pgid,%cpu,etime,command"*)
    for p in 900001 900002 900003 900004 900005 900006 900007 900008; do
      echo "  4${p#9000}   4241  $p   3.5 05:00 /usr/bin/node /w/node_modules/.bin/vite --port 5173"
    done ;;
  *"-o pgid= -p"*) echo " 111111" ;;
  *"pgid=,lstart="*) for p in 900001 900002 900003 900004 900005 900006 900007 900008; do echo "$p Mon Aug 18 10:00:00 2026 /usr/bin/rsync -a /backup /offsite"; done ;;
  *"pgid=,command="*) for p in 900001 900002 900003 900004 900005 900006 900007 900008; do echo "$p /usr/bin/rsync -a /backup /offsite"; done ;;
  *"-Ao pgid="*) for p in 900001 900002 900003 900004 900005 900006 900007 900008; do echo "$p"; done ;;
  *) exit 1 ;;
esac
